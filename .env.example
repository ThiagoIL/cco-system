# Copie este arquivo para .env (dev local) e preencha os valores reais.
# Em produção (EasyPanel), estas variáveis são configuradas na aba
# "Environment" do serviço — não use um arquivo .env em produção.

# Connection string do Postgres. Em produção, aponte para o host interno
# do serviço de banco de dados criado no EasyPanel (ex: nome-do-servico).
DATABASE_URL="postgres://usuario:senha@host:5432/nome_do_banco?sslmode=disable"

# Chave usada pelo NextAuth para assinar sessões/JWT.
# Gere uma nova com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-de-64-caracteres"

# URL pública onde a aplicação será acessada.
NEXTAUTH_URL="https://cco.seudominio.com.br"

# Usados apenas pelo `prisma db seed` para criar o usuário administrador inicial.
ADMIN_EMAIL="admin@rcondredetel.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Porta em que o servidor Node escuta (o EasyPanel injeta isso automaticamente
# na maioria dos casos; mantenha 3000 se não tiver certeza).
PORT=3000
